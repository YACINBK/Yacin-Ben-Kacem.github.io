---
const { steps = [] } = Astro.props;
---

<div class="architecture-flow" role="list" aria-label="System architecture">
    {steps.map((step) => (
        <div class="architecture-node" role="listitem">
            <strong>{step.label}</strong>
            <p>{step.detail}</p>
        </div>
    ))}
</div>
