---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { site, workEntries } from '../../data/site';
import { absoluteUrl } from '../../utils/paths';

const itemListSchema = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    url: absoluteUrl('/work', Astro.site),
    name: `${site.name} experience`,
    hasPart: workEntries.map((entry, index) => ({
        '@type': 'Role',
        position: index + 1,
        name: entry.role,
    })),
};
---

<BaseLayout
    title={`Experience | ${site.name}`}
    description="Internship and independent systems work."
    currentPath="/work"
    schema={[itemListSchema]}
>
    <div class="page-stack">
        <section class="timeline-list" aria-label="Work history">
            {workEntries.map((entry, index) => (
                <article class={`experience-card${index === 0 ? ' experience-card--featured' : ''}`} data-reveal>
                    <div class="experience-card__meta">
                        <span>{entry.type}</span>
                        <h2>{entry.role}</h2>
                        <p>{entry.organization}</p>
                        <p>{entry.range}</p>
                        <p>{entry.location}</p>
                    </div>

                    <div class="experience-card__body">
                        <p>{entry.summary}</p>
                        <div class="experience-groups">
                            {entry.groups.map((group) => (
                                <section class={group.range ? 'experience-stint' : undefined}>
                                    <div class="experience-stint__head">
                                        <strong>{group.label}</strong>
                                        {group.range && <span class="experience-stint__range">{group.range}</span>}
                                    </div>
                                    <ul class="system-list">
                                        {group.items.map((item) => (
                                            <li>{item}</li>
                                        ))}
                                    </ul>
                                </section>
                            ))}
                        </div>
                    </div>
                </article>
            ))}
        </section>
    </div>
</BaseLayout>

<style>
    /* Dated project blocks inside a single role — mirrors the CV treatment. */
    .experience-stint {
        padding-left: 1rem;
        border-left: 2px solid rgba(34, 211, 238, 0.28);
    }

    .experience-stint__head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        margin-bottom: 0.35rem;
    }

    .experience-stint__head strong {
        color: var(--cyan-bright);
        font-size: var(--text-base);
    }

    .experience-stint__range {
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-soft);
        white-space: nowrap;
    }
</style>
