---
import { site } from '../data/site';
import { absoluteUrl, withBase } from '../utils/paths';

const labPath = withBase('/lab');
const labUrl = absoluteUrl('/lab', Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{`The Lab | ${site.name}`}</title>
        <meta http-equiv="refresh" content={`0;url=${labPath}`} />
        <meta name="robots" content="noindex" />
        <link rel="canonical" href={labUrl} />
    </head>
    <body>
        <p>
            Applied Systems moved to
            <a href={labPath}>The Lab</a>.
        </p>
    </body>
</html>
