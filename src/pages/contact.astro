---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { absoluteUrl, withBase } from '../utils/paths';

const schema = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: absoluteUrl('/contact', Astro.site),
    name: `${site.name} contact`,
    description: 'Direct ways to reach Yacin Ben Kacem.',
};

const contacts = [
    { label: 'Email', value: site.email, action: 'Send', href: `mailto:${site.email}` },
    { label: 'GitHub', value: 'github.com/YACINBK', action: 'Open', href: site.github },
    { label: 'LinkedIn', value: 'linkedin.com/in/yacin-ben-kacem', action: 'Open', href: site.linkedin },
    { label: 'Academic email', value: site.academicEmail, action: 'Send', href: `mailto:${site.academicEmail}`, secondary: true }
];

const cv = site.cv;
---

<BaseLayout
    title={`Contact | ${site.name}`}
    description="Direct ways to reach me and review my work."
    currentPath="/contact"
    schema={[schema]}
>
    <div class="page-stack">
        <section class="section-block" data-reveal>
            <div class="section-label">Contact</div>
            <p class="contact-intro">Open to software engineering internships, backend systems work, and AI automation projects.</p>

            <article class="cv-card">
                <div class="contact-info">
                    <span class="contact-label">Curriculum vitae</span>
                    <strong class="contact-value">{cv.filename}</strong>
                    <span class="cv-card__meta">{cv.pages} · updated {cv.updated}</span>
                </div>
                <div class="contact-actions">
                    <a class="action-btn action-btn--primary" href={withBase(cv.href)} download={cv.filename}>
                        {cv.label}
                    </a>
                    <a class="action-btn" href={withBase(cv.href)} target="_blank" rel="noreferrer">View</a>
                </div>
            </article>

            <div class="contact-grid">
                {contacts.map((contact) => (
                    <article class={`contact-card ${contact.secondary ? 'contact-secondary' : ''}`}>
                        <div class="contact-info">
                            <span class="contact-label">{contact.label}</span>
                            <strong class="contact-value">{contact.value}</strong>
                        </div>
                        <div class="contact-actions">
                            {contact.label === 'Email' && (
                                <button class="action-btn copy-btn" data-value={contact.value}>Copy</button>
                            )}
                            <a href={contact.href} target={contact.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer" class="action-btn">
                                {contact.action}
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .contact-intro {
        color: var(--text-soft);
        font-size: var(--text-base);
        line-height: 1.7;
        margin-bottom: 2rem;
        max-width: 60ch;
    }

    .contact-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* Same shape as a contact card, lifted one step: the CV is the single thing a
       recruiter is most likely to want, so it sits above the grid with a cyan edge. */
    .cv-card {
        background: rgba(34, 211, 238, 0.04);
        border: 1px solid rgba(34, 211, 238, 0.28);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

    .cv-card:hover {
        background: rgba(34, 211, 238, 0.07);
        border-color: var(--cyan-bright);
    }

    .cv-card__meta {
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-top: 0.1rem;
    }

    @media (min-width: 640px) {
        .cv-card {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }

    .contact-card {
        background: var(--surface-card, rgba(255, 255, 255, 0.02));
        border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.05));
        border-radius: var(--radius-md, 12px);
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

    @media (min-width: 640px) {
        .contact-card {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }

    .contact-card:hover {
        background: var(--surface-hover, rgba(255, 255, 255, 0.04));
        border-color: var(--cyan-muted, rgba(34, 211, 238, 0.3));
    }

    .contact-secondary {
        opacity: 0.85;
    }
    .contact-secondary .contact-label {
        color: var(--text-soft);
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .contact-label {
        font-size: var(--text-xs);
        color: var(--text-soft);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .contact-value {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--cyan-bright);
        font-weight: 500;
        word-break: break-all;
    }

    .contact-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .action-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-main);
        font-size: var(--text-xs);
        font-weight: 500;
        padding: 0.4rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .action-btn:hover {
        background: rgba(34, 211, 238, 0.1);
        border-color: var(--cyan-bright);
        color: var(--cyan-bright);
    }

    .action-btn--primary {
        background: rgba(34, 211, 238, 0.14);
        border-color: rgba(34, 211, 238, 0.45);
        color: var(--cyan-bright);
        white-space: nowrap;
    }

    .action-btn--primary:hover {
        background: rgba(34, 211, 238, 0.22);
    }
</style>

<script>
    document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const val = btn.getAttribute('data-value');
            if (val) {
                try {
                    await navigator.clipboard.writeText(val);
                    const originalText = btn.textContent;
                    btn.textContent = 'Copied';
                    setTimeout(() => {
                        btn.textContent = originalText;
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy', err);
                }
            }
        });
    });
</script>
